{
  "name": "forestfire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A physically-based 3D forest and grass fire simulation running on WebGPU",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run test/validation",
    "bench:cpu": "vitest run --config vitest.bench.config.ts",
    "spec:status": "node scripts/spec-status.mjs",
    "headless": "node scripts/headless.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2"
  }
}
